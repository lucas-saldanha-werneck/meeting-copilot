#!/bin/bash
# meeting-copilot: live meeting copilot that reads the Muesli app's live transcript.
#   meeting-copilot [--no-open] [--db PATH] [--port N]   start (if needed) and open the page
#   meeting-copilot stop                                  stop it
#   meeting-copilot status                                say whether it is running
#   meeting-copilot log                                   show the end of the log
#   The page needs a token: the URL it prints and opens ends in ?token=... (kept in the data folder).
set -u

# Resolve the real script location, also when called through a symlink in ~/.local/bin.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
ROOT="$(cd "$(dirname "$src")/.." && pwd)"
APP="$ROOT/lib/copilot.py"

PY="${MEETING_COPILOT_PYTHON:-python3}"

# A setting from the environment or the config file (~/.config/meeting-copilot/config).
setting() { "$PY" "$APP" --get "$1" 2>/dev/null; }

DATA="$(setting DATA_DIR)"
DATA="${DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/meeting-copilot}"
PIDFILE="$DATA/meeting-copilot.pid"
LOG="${MEETING_COPILOT_LOG:-$DATA/meeting-copilot.log}"

port="$(setting PORT)"
port="${port:-4390}"
open_page=1
args=()
cmd=start
while [ $# -gt 0 ]; do
  case "$1" in
    stop|status|log|start) cmd="$1" ;;
    --no-open) open_page=0 ;;
    --port) port="$2"; args+=("--port" "$2"); shift ;;
    --db) args+=("--db" "$2"); shift ;;
    -h|--help) sed -n '2,7p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "meeting-copilot: unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done
URL="http://127.0.0.1:$port"

PORTFILE="$DATA/meeting-copilot.port"

# The pid in the pid file, only while that process is really this copilot: after a crash or a reboot
# the number can belong to another program, which must never be stopped or taken for the copilot.
running_pid() {
  [ -f "$PIDFILE" ] || return 1
  local p c
  p="$(cat "$PIDFILE" 2>/dev/null)"
  case "$p" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$p" 2>/dev/null || return 1
  c="$(ps -p "$p" -o command= 2>/dev/null)"
  case "$c" in *"$APP"*) echo "$p" ;; *) return 1 ;; esac
}

# The running copilot may have been started on another port: use the one it wrote down.
use_running_port() {
  local p="$1" fpid fport
  read -r fpid fport < "$PORTFILE" 2>/dev/null || return 0
  if [ "$fpid" = "$p" ] && [ -n "$fport" ]; then
    [ "$fport" != "$port" ] && echo "note: meeting-copilot is already running on port $fport; stop it first to use port $port" >&2
    port="$fport"
    URL="http://127.0.0.1:$port"
  fi
}

# The page token (the token file is made on first use, mode 0600, in the data folder).
page_token() { "$PY" "$APP" --token 2>/dev/null; }

# Whether our copilot answers /state with the token. The token goes in on stdin, never on the
# command line (other users can read process arguments).
page_up() {
  local tok="$1"
  if command -v curl >/dev/null 2>&1; then
    printf 'Authorization: Bearer %s\n' "$tok" | curl -sf -o /dev/null --max-time 1 -H @- "$URL/state"
  else
    printf '%s' "$tok" | "$PY" -c "
import sys, urllib.request
req = urllib.request.Request(sys.argv[1], headers={'Authorization': 'Bearer ' + sys.stdin.read().strip()})
urllib.request.urlopen(req, timeout=1)" "$URL/state" 2>/dev/null
  fi
}

# The page URL with its token.
page_url() {
  local tok
  tok="$(page_token)"
  if [ -n "$tok" ]; then echo "$URL/?token=$tok"; else echo "$URL"; fi
}

open_url() {
  # MEETING_COPILOT_OPEN_CMD: your own command, e.g. open -a "Firefox". The URL goes in as one
  # argument where {url} is, or at the end; it is never pasted into the command text.
  local cmd
  cmd="$(setting OPEN_CMD)"
  if [ -n "$cmd" ]; then
    case "$cmd" in
      *"{url}"*) cmd="${cmd//\{url\}/\"\$1\"}" ;;
      *) cmd="$cmd \"\$1\"" ;;
    esac
    # In the background, so a browser started directly (it keeps running) never holds the
    # terminal; a command that fails within 3 s is still reported. Its output goes to the log.
    bash -c "$cmd" meeting-copilot "$PAGE" </dev/null >>"$LOG" 2>&1 &
    local pid=$! i
    for i in $(seq 1 15); do kill -0 "$pid" 2>/dev/null || break; sleep 0.2; done
    if kill -0 "$pid" 2>/dev/null || wait "$pid"; then return 0; fi
    echo "meeting-copilot: MEETING_COPILOT_OPEN_CMD failed (see $LOG)" >&2
    return 1
  fi
  if [ "$(uname -s)" = "Darwin" ] && command -v open >/dev/null 2>&1; then
    open "$PAGE" && return 0
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$PAGE" >/dev/null 2>&1 && return 0
  fi
  return 1
}

case "$cmd" in
  stop)
    p="$(running_pid)"
    if [ -n "$p" ]; then
      kill "$p" && echo "meeting-copilot stopped"
      for _ in $(seq 1 20); do kill -0 "$p" 2>/dev/null || break; sleep 0.25; done
      rm -f "$PIDFILE" "$PORTFILE"
    else
      rm -f "$PIDFILE" "$PORTFILE"   # a stale file of a copilot that is gone
      echo "meeting-copilot was not running"
    fi ;;
  status)
    p="$(running_pid)"
    if [ -n "$p" ]; then use_running_port "$p"; echo "running (pid $p) on $(page_url)"; else echo "not running"; exit 1; fi ;;
  log)
    tail -n 30 "$LOG" 2>/dev/null || echo "no log yet: $LOG" ;;
  start)
    mkdir -p "$DATA" && chmod 700 "$DATA"
    p="$(running_pid)"
    if [ -n "$p" ]; then
      use_running_port "$p"
    else
      rm -f "$PORTFILE"
      tok="$(page_token)"   # made before the server starts, so both use the same file
      nohup "$PY" -u "$APP" ${args[@]+"${args[@]}"} >> "$LOG" 2>&1 &
      np=$!
      echo "$np" > "$PIDFILE"
      # kill -0 only here: until nohup has started python, the process does not look like the copilot yet
      for _ in $(seq 1 40); do
        kill -0 "$np" 2>/dev/null || break
        page_up "$tok" && break
        sleep 0.25
      done
    fi
    if [ -z "$(running_pid)" ]; then
      rm -f "$PIDFILE" "$PORTFILE"
      echo "meeting-copilot did not start. Last log lines:" >&2
      tail -n 5 "$LOG" >&2
      exit 1
    fi
    PAGE="$(page_url)"
    echo "meeting-copilot on $PAGE - start a meeting in Muesli"
    if [ "$open_page" = 1 ]; then
      open_url || echo "open $PAGE in your browser"
    fi ;;
esac
